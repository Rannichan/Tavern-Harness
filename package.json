{
  "name": "tavern-harness",
  "version": "0.1.27",
  "description": "Tavern Harness — 酒馆模式下的本地 AI Agent 助手（MyAgent-Android 的 Web 复刻）",
  "private": false,
  "type": "module",
  "bin": {
    "tavern-harness": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "index.html",
    "vite.config.ts",
    "sandbox-server.mjs",
    "persistence-server.mjs",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "test": "node --experimental-strip-types --test *.test.mjs",
    "test:character-book": "node --test character-book.test.mjs",
    "test:silly-tavern-world-info": "node --test silly-tavern-world-info.test.mjs",
    "test:openai-request": "node --test openai-request.test.mjs",
    "test:command-service": "node sandbox-server.test.mjs",
    "test:persistence-service": "node persistence-server.test.mjs",
    "test:yolo-mode": "node yolo-mode.test.mjs",
    "test:tool-arguments": "node tool-arguments.test.mjs",
    "test:long-press": "node --experimental-strip-types --test long-press.test.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:preview-persistence": "node preview-persistence.test.mjs",
    "changelog:new": "node scripts/changelog.mjs new",
    "changelog:build": "node scripts/changelog.mjs build",
    "changelog:check": "node scripts/changelog.mjs check",
    "changelog:check:release": "node scripts/changelog.mjs check --release",
    "prepublishOnly": "npm run build && npm run changelog:check:release"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "dexie": "^4.0.8",
    "dompurify": "^3.4.15",
    "katex": "^0.16.11",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "qrcode.react": "^4.2.0",
    "vite": "^5.4.21",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.5.4"
  }
}
